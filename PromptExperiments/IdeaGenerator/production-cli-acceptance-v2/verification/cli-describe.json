              },
              "audience": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "title",
              "description",
              "audience",
              "rationale",
              "evidence"
            ],
            "additionalProperties": false
          },
          "research": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string"
              }
            },
            "required": [
              "content"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "selectedIdea",

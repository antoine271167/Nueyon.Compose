{
  "name": "Nueyon.Compose",
  "commands": [
    {
      "kind": "RunWorkflow",
      "path": [
        "run",
        "workflow"
      ],
      "takesAgent": false,
      "description": "Run the complete production workflow.",
      "options": [
        {
          "name": "--input-directory",
          "valueType": "directory",
          "required": false,
          "description": "Markdown source directory (default data/input).",
          "formats": null,
          "agents": null
        },
        {
          "name": "--capture-inputs",
          "valueType": "directory",
          "required": false,
          "description": "Capture agent inputs in a unique directory.",
          "formats": null,
          "agents": null
        },
        {
          "name": "--prompts",
          "valueType": "directory",
          "required": false,
          "description": "Use a complete disk prompt set; the selected prompt source is reported on stderr.",
          "formats": null,
          "agents": null
        }
      ],
      "examples": [
        "run workflow --capture-inputs .\\captures"
      ],
      "syntax": "run workflow",
      "requiresRuntime": true
    },
    {
      "kind": "RunAgent",
      "path": [
        "run"
      ],
      "takesAgent": true,
      "description": "Run one agent from JSON.",
      "options": [
        {
          "name": "--input",
          "valueType": "json file",
          "required": true,
          "description": "Input JSON file.",
          "formats": null,
          "agents": null
        },
        {
          "name": "--output",
          "valueType": "json file",
          "required": true,
          "description": "New output JSON file.",
          "formats": null,
          "agents": null
        },
        {
          "name": "--prompts",
          "valueType": "directory",
          "required": false,
          "description": "Use a complete disk prompt set; the selected prompt source is reported on stderr.",
          "formats": null,
          "agents": null
        },
        {
          "name": "--trace",
          "valueType": "json file",
          "required": false,
          "description": "New Idea validation trace file.",
          "formats": null,
          "agents": [
            "idea"
          ]
        }
      ],
      "examples": [
        "run idea --input .\\idea.json --output .\\result.json --trace .\\trace.json"
      ],
      "syntax": "run <agent>",
      "requiresRuntime": true
    },
    {
      "kind": "AgentsList",
      "path": [
        "agents",
        "list"
      ],
      "takesAgent": false,
      "description": "List available agents.",
      "options": [],
      "examples": [
        "agents list"
      ],
      "syntax": "agents list",
      "requiresRuntime": false
    },
    {
      "kind": "AgentsDescribe",
      "path": [
        "agents",
        "describe"
      ],
      "takesAgent": true,
      "description": "Describe an agent.",
      "options": [
        {
          "name": "--format",
          "valueType": "text|json",
          "required": false,
          "description": "Output format (default text).",
          "formats": [
            "text",
            "json"
          ],
          "agents": null
        }
      ],
      "examples": [
        "agents describe idea --format json"
      ],
      "syntax": "agents describe <agent>",
      "requiresRuntime": false
    },
    {
      "kind": "AgentsSchema",
      "path": [
        "agents",
        "schema"
      ],
      "takesAgent": true,
      "description": "Export the standalone input JSON schema.",
      "options": [
        {
          "name": "--format",
          "valueType": "json",
          "required": true,
          "description": "Output format; must be json.",
          "formats": [
            "json"
          ],
          "agents": null
        }
      ],
      "examples": [
        "agents schema idea --format json"
      ],
      "syntax": "agents schema <agent>",
      "requiresRuntime": false
    },
    {
      "kind": "Describe",
      "path": [
        "describe"
      ],
      "takesAgent": false,
      "description": "Describe all commands, agents, help, defaults, schemas, exit codes, prompts and runtime requirements.",
      "options": [
        {
          "name": "--format",
          "valueType": "json",
          "required": true,
          "description": "Output format; must be json.",
          "formats": [
            "json"
          ],
          "agents": null
        }
      ],
      "examples": [
        "describe --format json"
      ],
      "syntax": "describe",
      "requiresRuntime": false
    }
  ],
  "help": {
    "option": "--help",
    "description": "Show this help.",
    "appliesTo": "all commands"
  },
  "noArguments": {
    "command": "run workflow",
    "description": "Run the production workflow with the default input directory.",
    "inputErrorExitCode": 1
  },
  "agents": [
    {
      "name": "idea",
      "description": "Generate and validate ranked ideas.",
      "inputType": "StoryInput",
      "outputType": "IReadOnlyList`1",
      "inputSchema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false,
        "description": "Input for the 'idea' agent: the JSON read by 'run idea --input'."
      },
      "outputSchema": {
        "type": "array",
        "items": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "audience": {
              "type": [
                "string",
                "null"
              ]
            },
            "rationale": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "title",
            "description",
            "audience",
            "rationale",
            "evidence"
          ],
          "additionalProperties": false
        },
        "description": "Result of the 'idea' agent: the JSON written by 'run idea --output'."
      },
      "traceSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "attempt": {
                  "type": [
                    "string",
                    "integer"
                  ],
                  "pattern": "^-?(?:0|[1-9]\\d*)$"
                },
                "response": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "feedback": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "retry": {
                  "type": [
                    "string",
                    "integer"
                  ],
                  "pattern": "^-?(?:0|[1-9]\\d*)$"
                }
              },
              "required": [
                "attempt",
                "response",
                "status",
                "feedback"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "status",
          "attempts"
        ],
        "additionalProperties": false,
        "description": "Opt-in Idea validation trace written by 'run idea --trace'."
      },
      "validation": {
        "kind": "idea-validation-loop",
        "appliesTo": "firstRankedIdea",
        "alternativesValidated": false,
        "structural": {
          "requiredNonEmptyFields": [
            "title",
            "description",
            "audience",
            "rationale"
          ]
        },
        "semantic": {
          "enabled": true,
          "judge": "IdeaSemanticJudge",
          "blocking": true
        },
        "maxAttempts": 3
      }
    },
    {
      "name": "research",
      "description": "Research a selected idea.",
      "inputType": "ResearchInput",
      "outputType": "ResearchResult",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string"
              }
            },
            "required": [
              "content"
            ],
            "additionalProperties": false
          },
          "selectedIdea": {
            "type": "object",
            "properties": {
              "idea": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "audience": {
                    "type": "string"
                  },
                  "rationale": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "title",
                  "description",
                  "audience",
                  "rationale",
                  "evidence"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "idea"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "input",
          "selectedIdea"
        ],
        "additionalProperties": false,
        "description": "Input for the 'research' agent: the JSON read by 'run research --input'."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "additionalProperties": false,
        "description": "Result of the 'research' agent: the JSON written by 'run research --output'."
      },
      "traceSchema": null,
      "validation": {
        "kind": "json-contract",
        "description": "JSON contract validation only; the agent may apply further runtime validation."
      }
    },

  ],
  "exitCodes": [
    {
      "code": 0,
      "meaning": "success"
    },
    {
      "code": 1,
      "meaning": "runtime or configuration failure (also input errors when run without arguments)"
    },
    {
      "code": 2,
      "meaning": "usage or input error"
    },
    {
      "code": 130,
      "meaning": "cancelled"
    }
  ],
  "promptDefaults": {
    "option": "--prompts",
    "strict": true,
    "resolutionOrder": [
      "--prompts <directory>",
      "<working directory>\\src\\Nueyon.Compose.Application\\Prompts",
      "<executable directory>\\Prompts",
      "embedded prompts"
    ]
  },
  "runtime": {
    "discoveryNeedsConfiguration": false,
    "commandsRequiringRuntime": [
      "run workflow",
      "run <agent>"
    ],
    "requiredConfiguration": [
      "OpenAI:ApiKey",
      "OpenAI:Model"
    ],
    "configurationSources": [
      "appsettings.json (working directory, then src\\Nueyon.Compose.Host.Console, then executable directory)",
      "appsettings.<ASPNETCORE_ENVIRONMENT>.json",
      "environment variables",
      "user secrets"
    ],
    "networkAccess": true,
    "mayIncurCost": true
  }
}
